{
  "_help": "Editing presets. 'auto' picks streamer_split when a facecam is found, else game_full. Colors are #RRGGBB. Times in seconds. LUTs: assets/luts/*.cube (lut_strength 0-1, empty lut = off). drop_overlay: folders in assets/overlays/ screen-blended on the drop (empty list = white flash).",

  "presets": {
    "streamer_split": {
      "description": "Reference reel Dcod99JqRXy: gameplay top, streamer face bottom, captions on the seam",
      "layout": "split",
      "top_panel_ratio": 0.55,
      "resolution": [1080, 1920],
      "fps": 30,
      "captions": "seam_typewriter",
      "hook_overlay": "typewriter_top",
      "motion": "punchy",
      "color_grade": "pop",
      "sound": "standard"
    },
    "game_full": {
      "description": "Reference reel DX7FlF_C7xD: full-frame cinematic crop following faces",
      "layout": "full",
      "resolution": [1080, 1920],
      "fps": 30,
      "captions": "center_typewriter",
      "hook_overlay": "typewriter_top",
      "motion": "smooth",
      "color_grade": "cinematic",
      "sound": "standard"
    }
  },

  "caption_styles": {
    "seam_typewriter": {
      "position_y": "seam",
      "small_font": "Arial Black",
      "small_size": 62,
      "small_color": "#FFFFFF",
      "keyword_font": "Arial Black",
      "keyword_size": 128,
      "keyword_color": "#FFCF1F",
      "keyword_italic": true,
      "shock_font": "Georgia",
      "shock_size": 124,
      "shock_color": "#F02D2D",
      "glow_size": 14,
      "glow_blur": 12,
      "max_words": 4,
      "max_chars": 22,
      "animation": "typewriter_pop",
      "uppercase": true,
      "censor_profanity": true
    },
    "center_typewriter": {
      "position_y": 1130,
      "small_font": "Arial Black",
      "small_size": 62,
      "small_color": "#FFFFFF",
      "keyword_font": "Arial Black",
      "keyword_size": 128,
      "keyword_color": "#FFCF1F",
      "keyword_italic": true,
      "shock_font": "Georgia",
      "shock_size": 124,
      "shock_color": "#F02D2D",
      "glow_size": 14,
      "glow_blur": 12,
      "max_words": 4,
      "max_chars": 22,
      "animation": "typewriter_pop",
      "uppercase": true,
      "censor_profanity": true
    }
  },

  "hook_overlays": {
    "typewriter_top": {"enabled": true, "position_y": 330, "seconds": 2.5},
    "none": {"enabled": false}
  },

  "motion": {
    "punchy": {
      "cold_open": true, "cold_open_seconds": 1.6,
      "intro_zoom": 1.22, "intro_seconds": 0.35,
      "punch_zoom": 0.13, "punch_decay": 0.45, "max_punches_per_4s": 1,
      "shake_px": 22, "shake_rotate_deg": 0.9,
      "slow_push": 0.035, "jump_cut_zoom": 1.09,
      "flash_transition": true, "glitch_transition": true,
      "cut_silences": true, "silence_min_gap": 0.8, "silence_keep": 0.3,
      "drop_overlay": ["flares", "film_burn", "light_leaks"], "drop_overlay_seconds": 1.0, "drop_overlay_strength": 0.9, "drop_overlay_lead": 0.1
    },
    "smooth": {
      "cold_open": true, "cold_open_seconds": 1.6,
      "intro_zoom": 1.12, "intro_seconds": 0.5,
      "punch_zoom": 0.07, "punch_decay": 0.8, "max_punches_per_4s": 1,
      "shake_px": 10, "shake_rotate_deg": 0.4,
      "slow_push": 0.05, "jump_cut_zoom": 1.06,
      "flash_transition": true, "glitch_transition": false,
      "cut_silences": true, "silence_min_gap": 1.0, "silence_keep": 0.35,
      "drop_overlay": ["film_burn", "light_leaks", "flares"], "drop_overlay_seconds": 1.1, "drop_overlay_strength": 0.8, "drop_overlay_lead": 0.1
    }
  },

  "color_grades": {
    "pop": {"contrast": 1.14, "gamma": 0.86, "saturation": 1.22, "sharpen": 0.55, "vignette": 0.22,
            "lut": "pack3_brightshades.cube", "lut_strength": 0.4},
    "cinematic": {"contrast": 1.18, "gamma": 0.9, "saturation": 1.1, "sharpen": 0.45, "vignette": 0.3,
                  "lut": "pack2_lut_urban_2.cube", "lut_strength": 0.5}
  },

  "sound": {
    "standard": {
      "music_volume": 0.42,
      "music_duck_under_speech": 0.22,
      "sfx_whoosh_on_cuts": 0.22,
      "sfx_whoosh_on_punch": 0.25,
      "sfx_boom_on_drop": 0.9,
      "sfx_riser_before_drop": 0.35,
      "sfx_glitch_on_drop": 0.6,
      "sfx_boom_on_shake": 0.45,
      "sfx_shutter_on_drop": 0.35,
      "noise_reduction": true,
      "loudness_lufs": -14,
      "true_peak_db": -1.5
    }
  },

  "export": {
    "video_codec": "libx264",
    "crf": 16,
    "preset": "slow",
    "audio_bitrate": "192k",
    "gpu_encoder": "auto_off"
  }
}

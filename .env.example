# Copy this file to .env and fill in your own values. .env is never committed to Git.

# ---------- AI (only the provider you choose in settings is used) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------- Google Sheets (Phase 4) ----------
# Path to the service-account JSON you download from Google Cloud (keep it in secrets/)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# ---------- YouTube posting (Phase 6) ----------
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
# Optional: the channel's Google account, so sign-in goes to it even if Chrome uses another account
YOUTUBE_LOGIN_HINT=

# ---------- Instagram posting (Phase 6) ----------
# Facebook Login host (needed to upload the file from this PC) - see docs/POSTING_SETUP.md
INSTAGRAM_API_HOST=graph.facebook.com
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v23.0

# ---------- Downloads ----------
# Only for age-restricted videos: firefox / chrome / edge (leave empty normally)
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=

# ---------- Machine ----------
# Keep big files off C:. These default to folders inside the project.
FARM_STORAGE_DIR=
HF_HOME=
# cpu or cuda (NVIDIA GPU with CUDA 12 + cuDNN 9)
WHISPER_DEVICE=cpu

# optional
YTDLP_COOKIE_CLIENT=
YOUTUBE_ANALYTICS_TOKEN_FILE=secrets/youtube_analytics_token.json
